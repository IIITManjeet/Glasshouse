{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix web ci",
  "buildCommand": "npm --prefix web run build",
  "outputDirectory": "web/out",
  "trailingSlash": true,
  "github": {
    "silent": true
  },
  "rewrites": [
    {
      "source": "/profile/:address",
      "destination": "/account/?a=:address"
    },
    {
      "source": "/profile/:address/",
      "destination": "/account/?a=:address"
    },
    {
      "source": "/r/:hash",
      "destination": "/round/?h=:hash"
    },
    {
      "source": "/r/:hash/",
      "destination": "/round/?h=:hash"
    }
  ],
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/opengraph-image/",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/og.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/board",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/board/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/proof",
      "destination": "/evidence",
      "permanent": true
    },
    {
      "source": "/proof/",
      "destination": "/evidence",
      "permanent": true
    },
    {
      "source": "/why",
      "destination": "/evidence",
      "permanent": true
    },
    {
      "source": "/why/",
      "destination": "/evidence",
      "permanent": true
    }
  ]
}
