node_modules/
artifacts/
cache/
types/
coverage/
.env
.env.*
deployments/localhost/
*.log

# Fork/local deployments are throwaway. Real deployment journals are kept -- they are the
# record of what was deployed and when -- but the solc build-info blobs beside them are
# large and machine-generated.
ignition/deployments/chain-31337/
ignition/deployments/*/build-info/

# Throwaway bidder keys from a live run; worth cents, but written so a crashed run is sweepable
.ephemeral-bidders.json

# Keeper round state, including the house bid salts it must be able to reveal with.
# Two files: the fork rehearsal (DRY_RUN=1) keeps its own cursor so it cannot consume a
# round out of the mainnet one. See the STATE_FILE comment in scripts/keeper.ts.
.keeper-state.json
.keeper-state.dryrun.json

# Next.js build output and deps
web/node_modules/
web/.next/
web/out/

# Generated from site/ by web/scripts/sync-assets.mjs on every build.
# Committing them would fork the argument and the snapshot.
web/public/argument.html
web/public/data/

.vercel
.env*

# TypeScript incremental build cache. Regenerated by every tsc/next build, and it was the
# one file that showed up dirty after any command that touched the app.
web/tsconfig.tsbuildinfo

# The screenshot rig, and its output. Both deliberately untracked.
#
# The shots are a working surface for judging margins, type sizes and placement; they are
# regenerated on demand, and a binary that changes on every UI tweak has no business in the
# history. The script is untracked too because it is a local tool rather than part of the
# product: it asserts nothing, no build or test depends on it, and it hard-codes a path to a
# Chrome binary on this machine. DESIGN.md is where its findings live, and those are the
# part worth keeping.
design-shots/
scripts/shoot-screens.mjs

# Working folder for AI-generated art: the prompts, and whatever comes back from them.
# Untracked on purpose -- the prompts are a scratchpad that changes every time an image
# disappoints, and generated PNGs have no business in a git history until one is actually
# chosen. The direction and the rules that survive live in DESIGN.md; anything CHOSEN gets
# committed to web/public/art/ and referenced from CSS.
art-prompts/
